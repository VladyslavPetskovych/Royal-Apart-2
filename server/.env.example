MONGOPASS=
LGTOKEN=
PSTOKEN=
WUDOO_API_KEY=
EMAIL_PASSWORD=
# API protection (see server/middleware/auth.js). Generate: openssl rand -hex 32
INTERNAL_API_KEY=
ADMIN_JWT_SECRET=
# set to true only after the admin panel build that sends the login token is live
ADMIN_AUTH_ENFORCE=false
WUBOOK_API_KEY=
WUBOOK_TOKEN=
WUBOOK_LCODE=
WUBOOK_XMLRPC_URL=https://wired.wubook.net/xrws/
WUBOOK_API_BASE=https://kapi.wubook.net
WUBOOK_CURRENCY=UAH
# Zak reservations sync for analytics/forecast (uses WUDOO_API_KEY). Set to off to disable.
ZAK_SYNC=on
